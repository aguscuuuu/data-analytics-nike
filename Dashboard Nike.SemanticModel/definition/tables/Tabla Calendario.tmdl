	partition 'Tabla Calendario' = calculated
		mode: import
		source =
				ADDCOLUMNS (
				        CALENDAR (
				            MIN('Fact_Nike_Ventas'[fecha_factura]),
				            MAX('Fact_Nike_Ventas'[fecha_factura])
				        ),
				        "id_fecha", FORMAT ( [Date], "YYYYMMDD" ),
				        "año", YEAR ( [Date] ),
				        "mes", FORMAT ( [Date], "MM" ),
				        "periodo", FORMAT ( [Date], "YYYY/MM" ),
				        "periodo2", FORMAT ( [Date], "YYYY/mmm" ),
				        "nombre_corto_mes", FORMAT ( [Date], "mmm" ),
				        "nombre_mes", FORMAT ( [Date], "mmmm" ),
				        "dia_semana_numero", WEEKDAY ( [Date] ),
				        "dia_semana", FORMAT ( [Date], "dddd" ),
				        "dia_semana_corto", FORMAT ( [Date], "ddd" ),
				        "cuatrimestre", "Q" & FORMAT ( [Date], "Q" ),
				        "año_cuatrimestre", FORMAT ( [Date], "YYYY" ) & "/Q" & FORMAT ( [Date], "Q" )
				    )

	annotation PBI_Id = 10e9f4b60521433c9234a8b558e9804b

