{
  "name": "Beach Pastel - Safe UI",
  "dataColors": [
    "#4EB9ED",
    "#76D3DB",
    "#EE9AC7",
    "#B5A1EE",
    "#6F915F",
    "#EBEBDF"
  ],
  "background": "#FFFFFF",
  "foreground": "#202020",
  "tableAccent": "#4EB9ED",
  "good": "#6F915F",
  "neutral": "#EBEBDF",
  "bad": "#EE9AC7",
  "minimum": "#B5A1EE",
  "center": "#76D3DB",
  "maximum": "#4EB9ED",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "background": {
              "solid": {
                "color": "#4EB9ED"
              }
            },
            "alignment": "left",
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F7FBFC"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#CDECF1"
              }
            },
            "radius": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#263238"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#607074"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#263238"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EAF8FB"
              }
            },
            "transparency": 0
          }
        ],
        "wallpaper": [
          {
            "color": {
              "solid": {
                "color": "#EAF8FB"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#4EB9ED"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
