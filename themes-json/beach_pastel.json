              "solid": {
                "color": "#CDECF1"
              }
            }
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#263238"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#F7FBFC"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#4EB9ED"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#263238"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#F7FBFC"
              }
            }
          }
        ]
      }
    },
    "filterPane": {
      "*": {
        "backgroundColor": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "foregroundColor": [
          {
            "color": {
              "solid": {
                "color": "#202020"
              }
            }
          }
        ],
        "borderColor": [
          {
            "color": {
              "solid": {
                "color": "#D9D9D9"
              }
            }
          }
        ]
      }
    },
    "filterCard": {
      "*": {
        "backgroundColor": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "foregroundColor": [
          {
            "color": {
              "solid": {
                "color": "#202020"
              }
            }
          }
        ],
        "borderColor": [
          {
            "color": {
              "solid": {
                "color": "#D9D9D9"
              }
            }
          }
        ]
      }
    }
