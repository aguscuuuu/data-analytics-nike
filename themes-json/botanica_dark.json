{
  "$schema": "https://powerbi.com/product/schema#visualStyles",
  "name": "Botánica Dark - Safe UI",
  "dataColors": [
    "#F549A4",
    "#7C7F3C",
    "#8FB9C6",
    "#E1CF8A",
    "#C4F2E7",
    "#FFFFFF",
    "#B9C0B6",
    "#6C725C"
  ],
  "background": "#FFFFFF",
  "foreground": "#252525",
  "tableAccent": "#F549A4",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#111312"
              }
            },
            "transparency": 0
          }
        ],
        "wallpaper": [
          {
            "color": {
              "solid": {
                "color": "#111312"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F8F7F1"
              }
            },
            "background": {
              "solid": {
                "color": "#2A3025"
              }
            },
            "alignment": "left",
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1B1D1B"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#3C4435"
              }
            },
            "radius": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F8F7F1"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#D7DACF"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#D7DACF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#D7DACF"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F8F7F1"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#D7DACF"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1B1D1B"
              }
            },
            "transparency": 0
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8F7F1"
              }
            },
            "textSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "selection": [
          {
            "color": {
              "solid": {
                "color": "#F549A4"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#3C4435"
              }
            },
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#3C4435"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#3C4435"
              }
            }
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8F7F1"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#1B1D1B"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8F7F1"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#2A3025"
              }
            }
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "grid": [
          {
            "outlineColor": {
              "solid": {
                "color": "#3C4435"
              }
            }
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8F7F1"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#1B1D1B"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8F7F1"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#2A3025"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#F8F7F1"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#1B1D1B"
              }
            }
          }
        ]
      }
    },
    "filterPane": {
      "*": {
        "backgroundColor": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "foregroundColor": [
          {
            "color": {
              "solid": {
                "color": "#252525"
              }
            }
          }
        ]
      }
    },
    "filterCard": {
      "*": {
        "backgroundColor": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "foregroundColor": [
          {
            "color": {
              "solid": {
                "color": "#252525"
              }
            }
          }
        ]
      }
    }
  }
}