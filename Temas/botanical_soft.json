{
  "name": "Botanical Soft - Safe UI",
  "dataColors": [
    "#8D7A1C",
    "#B3D1AC",
    "#D0EDEB",
    "#E6D3DC",
    "#FBF1F3"
  ],
  "background": "#FFFFFF",
  "foreground": "#202020",
  "tableAccent": "#8D7A1C",
  "good": "#B3D1AC",
  "neutral": "#D0EDEB",
