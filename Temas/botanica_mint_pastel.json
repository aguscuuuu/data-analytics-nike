{
  "$schema": "https://powerbi.com/product/schema#visualStyles",
  "name": "Botánica Mint Pastel - Safe UI",
  "dataColors": [
    "#C4F2E7",
    "#8FB9C6",
    "#F549A4",
    "#E1CF8A",
    "#7C7F3C",
    "#F7FAF9",
    "#789A91",
    "#BD9A35"
  ],
  "background": "#FFFFFF",
  "foreground": "#252525",
  "tableAccent": "#F549A4",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EAF8F4"
              }
            },
            "transparency": 0
          }
        ],
        "wallpaper": [
          {
            "color": {
              "solid": {
                "color": "#EAF8F4"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#243230"
              }
            },
            "background": {
              "solid": {
                "color": "#C4F2E7"
              }
            },
            "alignment": "left",
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#BFE1D9"
              }
            },
            "radius": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#243230"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5B706B"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B706B"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "visualHeader": [
          {
            "foreground": {
              "solid": {
                "color": "#5B706B"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#243230"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5B706B"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#243230"
              }
            },
            "textSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "selection": [
          {
            "color": {
              "solid": {
                "color": "#F549A4"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#BFE1D9"
              }
            },
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#BFE1D9"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#BFE1D9"
              }
            }
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#243230"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#243230"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#C4F2E7"
              }
            }
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "grid": [
          {
            "outlineColor": {
              "solid": {
                "color": "#BFE1D9"
              }
            }
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#243230"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#243230"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#C4F2E7"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#243230"
              }
            },
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "filterPane": {
      "*": {
        "backgroundColor": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "foregroundColor": [
          {
            "color": {
              "solid": {
                "color": "#252525"
              }
            }
          }
        ]
      }
    },
    "filterCard": {
      "*": {
        "backgroundColor": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "foregroundColor": [
          {
            "color": {
              "solid": {
                "color": "#252525"
              }
            }
          }
        ]
      }
    }
  }
}